  "verifier.sample_noncritical": 0.5,
  "mermaid.max_nodes": 40,
  "dynamic.enabled": false,
  "dynamic.network": false,
  "report.formats": ["md", "json", "html"],
  "report.snippets": true,
  "report.snippet_max_lines": 30,
  "secrets.redact": true
}