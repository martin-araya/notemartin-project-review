{
  "lang": "es",
  "workspace.dir": ".project-review",
  "subagents.mode": "auto",
  "subagents.max_parallel": "auto",
  "wu.context_fraction": 0.5,
  "files.giant_threshold_lines": 2000,
  "files.chunk_overlap_lines": 40,
  "symbols.backend": "auto",
  "branches.follow_depth": null,
  "question.graph_hops": 2,
  "git.cochange_min": 3,
