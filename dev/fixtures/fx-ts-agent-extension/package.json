{
  "name": "fx-ts-agent-extension",
  "version": "1.0.0",
  "description": "Fixture de extension de agente de codigo (F06b) para notemartin-project-review",
  "type": "module",
  "main": "dist/extension.js",
  "scripts": {
    "build": "esbuild src/host/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "test": "vitest run --reporter=verbose",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "fxagent.changeMode",
        "title": "Change agent mode"
      },
      {
        "command": "fxagent.loadSkill",
        "title": "Load skill from disk"
      },
      {
        "command": "fxagent.approveTool",
        "title": "Approve pending tool call"
      },
      {
        "command": "fxagent.condense",
        "title": "Force context condensation"
      },
      {
        "command": "fxagent.showWebview",
        "title": "Open the agent webview"
      },
      {
        "command": "fxagent.listSkills",
        "title": "List discovered skills"
      }
    ],
    "activationEvents": [
      "onCommand:fxagent.showWebview"
    ]
  }
}
