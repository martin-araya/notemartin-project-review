    "source": [
     "import mlflow",
     "import pandas as pd",
     "",
     "mlflow.set_tracking_uri('file:///fixture/mlruns')",
     "tracking_uri = 'file:///fixture/mlruns'",
     "model_name = 'iris_clf'",
     "model_uri = f'models:/{model_name}@production'",
     "try:",
     "    model = mlflow.pyfunc.load_model(model_uri)",
     "    df = pd.DataFrame([{'sepal_length': 5.1, 'sepal_width': 3.5, 'petal_length': 1.4, 'petal_width': 0.2}])",
     "    pred = model.predict(df)",
     "    print('prediction:', pred)",
     "except Exception as e:",
     "    print('skipped: model not available:', type(e).__name__)",
     ""
    ]
   }
