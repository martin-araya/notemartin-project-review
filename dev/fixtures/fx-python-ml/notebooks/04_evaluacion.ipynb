    "source": [
     "import mlflow",
     "import pandas as pd",
     "from src.evaluate import evaluate_model, log_metrics",
     "",
     "mlflow.set_tracking_uri('file:///fixture/mlruns')",
     "df = pd.read_csv('/fixture/data/iris.csv')",
     "X = df.drop(columns=['species'])",
     "y = df['species']",
     "model = __import__('src.train', fromlist=['train_model']).train_model('random_forest', X, y, random_state=42)",
     "",
     "metrics = evaluate_model(model, X, y, metrica='f1', average='weighted')",
     "log_metrics(metrics, tracking_uri='file:///fixture/mlruns')",
     "import json as _json",
     "with open('/fixture/metrics/eval.json', 'w') as f:",
     "    _json.dump(metrics, f)",
     "print('metrics:', metrics)",
     ""
    ]
   }
  ]
