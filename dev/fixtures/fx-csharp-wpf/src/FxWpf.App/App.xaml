<Application x:Class="FxWpf.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FxWpf.App.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- Trampa E6: Merged dictionaries con 3 fuentes externas.
             La skill debe seguir las referencias en cascada. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Styles/ButtonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Trampa E4: converters registrados en Application.Resources. -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToBoolConverter x:Key="NullToBool" />
            <conv:CurrencyConverter x:Key="Currency" />
        </ResourceDictionary>
    </Application.Resources>
</Application>