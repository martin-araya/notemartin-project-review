# Imagen para ejecutar los tests del fixture F06k (SvelteKit).
FROM node:22-bookworm-slim

WORKDIR /fixture

COPY package.json ./
RUN npm install --no-audit --no-fund --prefer-offline || npm install --no-audit --no-fund

# SvelteKit genera tipos en .svelte-kit/. Lo hacemos antes de los tests.
RUN npx svelte-kit sync || true

COPY . .

CMD ["make", "test"]
