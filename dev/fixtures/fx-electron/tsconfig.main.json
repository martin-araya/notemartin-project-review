{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/workers/**/*"]
}