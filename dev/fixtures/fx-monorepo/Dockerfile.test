# Imagen con Node 22 + pnpm 9 (via corepack) para correr el monorepo.
# El host de desarrollo no necesita node ni pnpm: el harness levanta este
# contenedor.
FROM node:22-bookworm-slim

WORKDIR /fixture

# Habilita corepack para usar pnpm@9.12.0.
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate

# Copiamos los manifests primero (incluyendo los de cada workspace) para
# cachear la resolucion de dependencias en una capa estable.
COPY package.json pnpm-workspace.yaml turbo.json .npmrc ./
COPY pnpm-lock.yaml* ./
COPY libs/shared/package.json ./libs/shared/
COPY libs/shared/tsconfig.json ./libs/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/api/tsconfig.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY apps/web/tsconfig.json ./apps/web/
COPY apps/web/tsconfig.app.json ./apps/web/
COPY apps/web/angular.json ./apps/web/
RUN pnpm install --prefer-offline || pnpm install

# Ahora copiamos el resto del codigo fuente.
COPY . .

# Por defecto, ejecutar los tests via turbo.
CMD ["pnpm", "test"]
