# Imagen para ejecutar los tests del fixture F06j (Nuxt 3).
FROM node:22-bookworm-slim

WORKDIR /fixture

COPY package.json ./
RUN npm install --no-audit --no-fund --prefer-offline || npm install --no-audit --no-fund

# Preparar tipos y auto-imports de Nuxt.
RUN npx nuxt prepare || true

COPY . .

CMD ["make", "test"]
