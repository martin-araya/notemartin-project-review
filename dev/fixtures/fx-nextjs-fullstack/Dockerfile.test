# Imagen para ejecutar los tests del fixture F06h (Next.js fullstack).
# El host de desarrollo no necesita node/playwright; el harness levanta este contenedor.
FROM node:22-bookworm-slim

WORKDIR /fixture

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Cacheamos package.json para reusar npm install entre builds.
COPY package.json ./
RUN npm install --no-audit --no-fund --prefer-offline || npm install --no-audit --no-fund

COPY . .

# Prisma genera el cliente en cada build.
RUN npx prisma generate || true

# Playwright con Chromium (no usamos Playwright en el smoke test local,
# pero el contenedor lo trae para que run_fixture_tests pueda ejecutar
# los specs E2E si la plataforma los soporta).
RUN npx playwright install --with-deps chromium || true

CMD ["make", "test"]