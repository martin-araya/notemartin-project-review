# Imagen para ejecutar los tests del fixture F06p (Django).
FROM python:3.11-slim

# make no viene en la imagen base; instalamos build-essential.
RUN apt-get update && apt-get install -y --no-install-recommends make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /fixture

# Cache de dependencias.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt 2>&1 | tail -5 || true

COPY . .

CMD ["make", "test"]