{
  "name": "fx-vanilla-js-legacy",
  "version": "1.0.0",
  "description": "Fixture F06i: app web legacy ES5 + jQuery + Express con 6 trampas de orden, delegacion, monkey-patching y string dispatch.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "jest --runInBand --verbose",
    "build:dist": "gulp"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jquery": "3.7.1",
    "jquery-colorbox": "^1.6.4",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "gulp": "^4.0.2",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^5.1.0",
    "gulp-uglify": "^3.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "sass": "^1.77.8",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEach": [],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "verbose": true
  }
}
