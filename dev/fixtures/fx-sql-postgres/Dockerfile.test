# Dockerfile.test del fixture F06ah (fx-sql-postgres).
# postgres:16-alpine + pg_cron 1.6 + pg_prove + Flyway 10 + JDK 21.
FROM postgres:16-alpine

ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV POSTGRES_DB=fxpg_test

# Instalar JDK 21 + bash + git + make + curl
RUN apk add --no-cache bash git make curl openjdk21-jdk
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

# Descargar e instalar pg_cron 1.6
RUN apk add --no-cache build-base autoconf automake libtool \
    && git clone --depth=1 --branch=REL1_6_STABLE https://github.com/citusdata/pg_cron.git /tmp/pg_cron \
    && cd /tmp/pg_cron \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pg_cron

# Instalar pg_prove (pgTAP)
RUN apk add --no-cache perl perl-io-tidy perl-list-moreutils perl-dbd-pg \
    && cpan TAP::Parser::SourceHandler::pgTAP

# Instalar Flyway 10
RUN mkdir -p /opt/flyway && cd /opt/flyway \
    && curl -L -o flyway.tar.gz https://repo1.maven.org/maven2/org/flywaydb/flyway-commandline/10.20.1/flyway-commandline-10.20.1-linux-x64.tar.gz \
    && tar -xzf flyway.tar.gz --strip-components=1 \
    && rm flyway.tar.gz
ENV FLYWAY_HOME=/opt/flyway
ENV PATH=$FLYWAY_HOME:$PATH

# Configurar pg_cron en postgresql.conf (cargado en shared_preload_libraries)
RUN echo "shared_preload_libraries = 'pg_cron'" >> /usr/local/share/postgresql/postgresql.conf.sample \
    && echo "cron.database_name = 'fxpg_test'" >> /usr/local/share/postgresql/postgresql.conf.sample

WORKDIR /fixture

# Copia el fixture
COPY . /fixture/

# Precompila dependencias (no-op en SQL pero cache de Docker layer)
RUN true

# Inicia PostgreSQL con pg_cron y aplica migraciones
CMD ["make", "test"]