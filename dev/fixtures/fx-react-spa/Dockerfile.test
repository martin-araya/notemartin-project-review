# Imagen para ejecutar los tests del fixture F06g (React SPA).
# El host de desarrollo no necesita node/npm; el harness levanta este contenedor.
FROM node:22-bookworm-slim

WORKDIR /fixture

# Cacheamos el package.json para que npm install se reuse entre builds.
COPY package.json ./
RUN npm install --no-audit --no-fund --prefer-offline || npm install --no-audit --no-fund

COPY . .

CMD ["make", "test"]