<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Trampa E1: permisos declarativos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FxAndroidApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FxAndroid"
        tools:targetApi="34">

        <!-- Trampa E1: Activity declarado en manifest (no llamado desde código) -->
        <activity
            android:name=".ui.legacy.LegacyProductActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light" />

        <!-- Trampa E6: BroadcastReceiver con intent-filter para deep links -->
        <receiver
            android:name=".receiver.SyncTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.fxandroid.SYNC_TRIGGER" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fxandroid" android:host="product" />
            </intent-filter>
        </receiver>

        <!-- Service declarado para completar la trampa E1 (no usado por código) -->
        <service
            android:name=".work.SyncService"
            android:exported="false" />
    </application>
</manifest>