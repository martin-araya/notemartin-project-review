# Imagen multi-toolchain: Rust trae cargo, bats y jq via apt, Go via apt.
FROM rust:1-bookworm

WORKDIR /fixture

RUN apt-get update && apt-get install -y --no-install-recommends \
        golang-go \
        bats \
        jq \
        file \
        binutils \
        coreutils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Cache de dependencias Rust.
COPY src/transformacion/Cargo.toml src/transformacion/Cargo.lock* ./src/transformacion/
RUN mkdir -p src/transformacion/src && \
    cd src/transformacion && \
    echo 'fn main() {}' > src/main.rs && \
    cargo build --release && \
    rm -rf src target/release/deps/transformacion*

COPY . /fixture/

# Compila los binarios del fixture (los tests los invocan).
RUN cd src/ingesta && go build -o /usr/local/bin/ingesta . && \
  cd src/transformacion && \
  cargo build --release --features v1 --bin transformacion && \
  cp target/release/transformacion /usr/local/bin/transformacion-linux && \
  cargo build --release --no-default-features --features v2,strict --bin transformacion_v2 && \
  cp target/release/transformacion_v2 /usr/local/bin/transformacion-linux-v2

CMD ["make", "test"]