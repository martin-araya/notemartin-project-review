{
    "name": "npr/fx-php-laravel",
    "type": "project",
    "description": "Fixture F06u: Laravel 10 application with Eloquent, Facades, Events, Observers, Jobs, middleware groups and route model binding.",
    "keywords": ["laravel", "eloquent", "fixtures"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.43",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "abandoned": "ignore"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
