# Imagen para ejecutar los tests del fixture F06u (Laravel).
FROM php:8.2-cli

# make, git y unzip son necesarios para composer y para invocar make.
RUN apt-get update && apt-get install -y --no-install-recommends \
    make \
    git \
    unzip \
    libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

# Extensiones PHP requeridas por Laravel + SQLite.
RUN docker-php-ext-install pdo pdo_sqlite

# Composer (imagen oficial).
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /fixture

# Cache de dependencias.
COPY composer.json ./
RUN composer config --global audit.abandoned ignore && \
    composer install --no-interaction --prefer-dist --no-scripts --no-security-blocking 2>&1 | tail -30 || true

COPY . .

# Crear bootstrap/cache para que Laravel pueda escribir el package manifest.
RUN mkdir -p bootstrap/cache storage/framework/{cache/data,sessions,views} storage/logs && \
    chmod -R 0777 bootstrap/cache storage

# Sanity check: el binario artisan debe poder listar comandos.
RUN php artisan list 2>&1 | head -10 || true

CMD ["make", "test"]
