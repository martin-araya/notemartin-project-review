<h1>Facturas</h1>
<table>
  <thead>
    <tr><th>ID</th><th>Proyecto</th><th>Monto</th><th>IVA</th><th>Total</th><th>Estado</th></tr>
  </thead>
  <tbody>
    <% @facturas.each do |f| %>
      <tr>
        <td><%= f.id %></td>
        <td><%= f.proyecto_id %></td>
        <td><%= number_to_currency(f.monto_euros) %></td>
        <td><%= f.tarifa_iva %>%</td>
        <td><%= number_to_currency(f.total_con_iva) %></td>
        <td><%= f.estado %></td>
      </tr>
    <% end %>
  </tbody>
</table>
