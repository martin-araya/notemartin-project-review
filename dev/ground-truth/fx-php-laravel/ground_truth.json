  "traps": [
    {"id": "TRAP-E01", "kind": "facades", "where": "app/Facades/PricingFacade.php: getFacadeAccessor() + config/app.php: aliases['Pricing'] + app/Http/Controllers/VisitController.php: Pricing::calculate(...)", "resolution": "Las llamadas estaticas a Pricing::calculate() se resuelven por el contenedor apuntando a la clave 'pricing.service'. La skill debe buscar el alias en config/app.php, la facade en app/Facades/ y el binding en InmuebleServiceProvider."},
    {"id": "TRAP-E02", "kind": "eloquent_magic", "where": "app/Models/Property.php: getPriceEurosAttribute, scopeAvailable, visits(), static::observe + app/Models/Contract.php: getMonthlyRentEurosAttribute", "resolution": "Eloquent genera metodos magicos (accessors, scopes, relaciones) a partir de convenciones de nombres. La skill debe notar los nombres 'getXxxAttribute', 'scopeXxx' y 'xxx()' para descubrir la API implicita."},
    {"id": "TRAP-E03", "kind": "service_providers_bindings", "where": "app/Providers/InmuebleServiceProvider.php: bind(VisitRepository::class, EloquentVisitRepository::class) + singleton('pricing.service', ...) + config/app.php: providers array", "resolution": "Los service providers registran dependencias en el contenedor. La skill debe listar todos los providers en config/app.php y ver que se registra en cada uno."},
    {"id": "TRAP-E04", "kind": "events_observers_listeners", "where": "app/Providers/EventServiceProvider.php: protected $listen + app/Listeners/SendVisitConfirmation.php + app/Observers/PropertyObserver.php", "resolution": "Laravel auto-descubre listeners del array $listen. Los observers se registran en boot() del modelo. La skill debe seguir el flujo: event() -> EventServiceProvider -> listener -> job dispatched."},
    {"id": "TRAP-E05", "kind": "middleware_groups_route_model_binding", "where": "app/Http/Kernel.php: middlewareGroups['web'] con EnsureTenant::class + routes/web.php: /properties/{property}", "resolution": "Las rutas con {param} se resuelven via route model binding. El middleware se aplica por grupo. La skill debe notar los middleware groups en Http/Kernel.php y los placeholders de parametros en routes."},
    {"id": "TRAP-E06", "kind": "console_schedule", "where": "app/Console/Kernel.php: schedule() con command(ExpireContracts::class)->dailyAt('00:00') + app/Console/Commands/ExpireContracts.php", "resolution": "Las tareas programadas se declaran en el metodo schedule() de App\\Console\\Kernel (Laravel 10). La skill debe leer Console/Kernel.php para descubrir comandos y schedules."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "job_silent_retry", "where": "app/Jobs/SendVisitReminder.php: public int $tries = 3 + public int $backoff = 10 + handle() con fail()", "resolution": "El job se reintenta hasta 3 veces con backoff de 10s. El controller responde 202 sin esperar al job, por lo que el usuario nunca ve si fallo o no."},
    {"id": "TRAP-P02", "kind": "job_empty_catch", "where": "app/Jobs/GenerateContractPdf.php: catch (\\Throwable $e) { Log::error(...); } sin rethrow", "resolution": "El catch se traga todos los errores y registra Log::error. El job se marca como exitoso aunque el PDF no se haya generado, y el contrato queda sin PDF."},
    {"id": "TRAP-P03", "kind": "facade_alias_typo", "where": "config/app.php: 'Pricing' => App\\Facades\\PricingFacade::class", "resolution": "Trampa latente: un typo en el namespace del alias rompe la facade. La skill debe verificar que el namespace del alias matchea la clase real."},
    {"id": "TRAP-P04", "kind": "queue_driver_mismatch", "where": "phpunit.xml: QUEUE_CONNECTION=database + config/queue.php: drivers 'database' y 'redis'", "resolution": "phpunit.xml fuerza el driver a 'database' (SQLite en memoria). En produccion el driver seria 'redis'. La skill debe notar que la configuracion efectiva de tests difiere de la default."},
    {"id": "TRAP-P05", "kind": "eloquent_n_plus_one", "where": "app/Http/Controllers/PropertyController.php: index() carga N properties y luego llama $property->visits()->count() en el map", "resolution": "N+1 silencioso: cada property dispara una query adicional para contar visitas. La trampa: el codigo compila y funciona, pero genera N+1 queries a la DB."},
    {"id": "TRAP-P06", "kind": "unused_middleware", "where": "app/Http/Kernel.php: middlewareGroups['web'] con EnsureTenant::class + app/Http/Middleware/EnsureTenant.php", "resolution": "El middleware esta registrado en el grupo 'web' pero su implementacion no hace nada (solo pasa al siguiente middleware). La skill debe notar que la declaracion existe pero el handler es vacio."}
  ],
  "superficial_traps": [
    {"id": "TRAP-S01", "kind": "dead_provider", "where": "app/Providers/LegacyServiceProvider.php (registrado en config/app.php providers array con comentario 'legacy only')", "resolution": "Provider dead. Registrado pero no aporta bindings ni listeners. La skill debe listarlo y notar la falta de consumidores."},
    {"id": "TRAP-S02", "kind": "dead_helper_reference", "where": "app/Providers/InmuebleServiceProvider.php: bind('legacy.helper', fn => new \\App\\Pricing\\LegacyHelper())", "resolution": "Referencia a una clase (App\\Pricing\\LegacyHelper) que no existe en el codigo. El binding solo se rompe en runtime cuando algo lo solicita."},
    {"id": "TRAP-S03", "kind": "dead_route", "where": "routes/web.php: Route::get('/legacy', 'App\\Http\\Controllers\\LegacyController@index')", "resolution": "Ruta dead que apunta a un controller inexistente. No se ejecuta porque ninguna ruta la invoca en tests, pero aparece en el listado de rutas."}
