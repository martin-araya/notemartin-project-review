  "features": [
    {
      "id": "FEAT-001",
      "name": "stock",
      "user_description": "CRUD de stock con trigger AFTER INSERT que audita movimientos, trigger INSTEAD OF UPDATE sobre vista, y busqueda dinamica parametrizada vs raw (P1).",
      "traces": [
        {"n": 1, "what": "User inserta movimiento en stock_movements", "cite": "db/migration/V001__init_schema.sql:16", "data_in": "sku, movement_type, quantity", "data_out": "movement_id IDENTITY"},
        {"n": 2, "what": "Trigger AFTER INSERT dispara e inserta en stock_audit", "cite": "db/migration/V002__init_triggers.sql:8", "data_in": "inserted.*", "data_out": "audit row"},
        {"n": 3, "what": "User consulta fn_stock_available(sku)", "cite": "db/sql/functions.sql:5", "data_in": "sku", "data_out": "quantity_on_hand"},
        {"n": 4, "what": "User actualiza vw_stock_current (vista)", "cite": "db/sql/views.sql:5", "data_in": "sku, description, quantity_on_hand", "data_out": "UPDATE in dbo.stock_items via INSTEAD OF trigger"},
        {"n": 5, "what": "Trigger INSTEAD OF propaga solo description (P3 trap)", "cite": "db/migration/V002__init_triggers.sql:25", "data_in": "inserted.*", "data_out": "UPDATE si SET si.description = i.description (quantity_on_hand sin tocar)"},
        {"n": 6, "what": "User ejecuta usp_stock_search_dynamic con patron", "cite": "db/migration/V004__dynamic_sql_search.sql:10", "data_in": "pattern, min_qty", "data_out": "rows parametrizados via sp_executesql"},
        {"n": 7, "what": "Trampa P1: usp_stock_search_raw concatena string", "cite": "db/migration/V004__dynamic_sql_search.sql:21", "data_in": "raw_filter NVARCHAR(MAX)", "data_out": "SQL string concatenado, SQLi"}
      ],
      "decision_points": [
        {"id": "DP-001", "file": "db/migration/V002__init_triggers.sql", "line": 8, "kind": "after_insert_trigger", "condition_text": "INSERT en stock_movements dispara trigger AFTER", "branches": [{"label": "ok -> INSERT en stock_audit", "target_line": 11}, {"label": "fail -> trigger no existe (drop manual)", "target_line": 8}]},
        {"id": "DP-002", "file": "db/migration/V004__dynamic_sql_search.sql", "line": 21, "kind": "dynamic_sql_concat", "condition_text": "EXEC sp_executesql con SQL concatenado en usp_stock_search_raw", "branches": [{"label": "param_ok: sp_executesql con @params (usp_stock_search_dynamic)", "target_line": 11}, {"label": "sql_injection: string concat (usp_stock_search_raw)", "target_line": 25}]}
      ],
      "outcomes": [
        {"id": "R-01", "category": "success_full", "conditions": "INSERT valido en stock_movements", "user_sees": "movement_id + row en stock_audit via trigger", "side_effects": ["INSERT en stock_movements", "INSERT en stock_audit via trigger"], "reversible": true, "final_state": "movimiento registrado y auditado"},
        {"id": "R-02", "category": "validation_input", "conditions": "INSERT con movement_type invalido", "user_sees": "CHECK constraint violation", "side_effects": [], "reversible": true, "final_state": "INSERT fallido"},
        {"id": "R-03", "category": "error_constraint", "conditions": "INSERT con sku inexistente", "user_sees": "FK violation (REFERENCE stock_items)", "side_effects": [], "reversible": true, "final_state": "INSERT fallido"},
        {"id": "R-04", "category": "noop_silent", "conditions": "UPDATE directo sobre vw_stock_current sin INSTEAD OF", "user_sees": "View is not updatable via direct UPDATE", "side_effects": [], "reversible": true, "final_state": "UPDATE fallido silenciosamente"},
        {"id": "R-05", "category": "success_partial", "conditions": "UPDATE sobre vw_stock_current via INSTEAD OF trigger", "user_sees": "Solo description propaga; quantity_on_hand no cambia (P3)", "side_effects": ["UPDATE dbo.stock_items SET description (sin quantity_on_hand)"], "reversible": true, "final_state": "description actualizado, quantity_on_hand intacto"},
        {"id": "R-06", "category": "success_full", "conditions": "usp_stock_search_dynamic con patron valido", "user_sees": "rows via sp_executesql parametrizado", "side_effects": [], "reversible": true, "final_state": "resultado via parametros"},
        {"id": "R-07", "category": "error_external_service", "conditions": "usp_stock_search_raw con raw_filter = '1=1; DROP TABLE stock_items;--'", "user_sees": "SQLi ejecutado: DROP TABLE stock_items (silently)", "side_effects": ["posible DROP TABLE no autorizado"], "reversible": false, "final_state": "vulnerabilidad explotada"}
      ],
      "config": [
        {"key": "MSSQL_SA_PASSWORD", "kind": "env", "default": "SqlServer2022!", "effect": "SA password para docker"},
        {"key": "ACCEPT_EULA", "kind": "env", "default": "Y", "effect": "EULA aceptada para Microsoft SQL Server"},
        {"key": "MSSQL_PID", "kind": "env", "default": "Developer", "effect": "Edition: Developer (incluye SQL Agent)"}
      ]
    },
    {
      "id": "FEAT-002",
      "name": "reconcile",
      "user_description": "Ejecuta conciliacion entre stock_on_hand y actual usando MERGE con OUTPUT $action; usp_reconcile_partial como alternativa incompleta (P2).",
      "traces": [
        {"n": 1, "what": "User crea run en reconcile_runs", "cite": "db/migration/V001__init_schema.sql:24", "data_in": "ninguno (DEFAULT)", "data_out": "run_id IDENTITY"},
        {"n": 2, "what": "User ejecuta usp_reconcile_run(@run_id)", "cite": "db/migration/V005__merge_conciliacion.sql:7", "data_in": "run_id INT", "data_out": "MERGE ejecuta"},
        {"n": 3, "what": "MERGE inserta/actualiza reconcile_lines y emite OUTPUT $action", "cite": "db/migration/V005__merge_conciliacion.sql:21", "data_in": "rows source", "data_out": "rows en reconcile_lines + reconcile_audit"},
        {"n": 4, "what": "User consulta vw_reconcile_dashboard", "cite": "db/sql/views.sql:14", "data_in": "ninguno", "data_out": "rows con delta esperado vs actual"},
        {"n": 5, "what": "User marca run como COMPLETED", "cite": "db/test/02_reconcile_test.sql:18", "data_in": "run_id", "data_out": "status = N'COMPLETED'"},
        {"n": 6, "what": "Trampa P2: usp_reconcile_partial sin WHEN NOT MATCHED BY SOURCE", "cite": "db/migration/V005__merge_conciliacion.sql:32", "data_in": "run_id", "data_out": "SKUs eliminados de stock_items quedan en reconcile_lines (huerfanos)"},
        {"n": 7, "what": "User consulta fn_reconcile_status(@run_id)", "cite": "db/sql/functions.sql:18", "data_in": "run_id", "data_out": "status NVARCHAR(16)"}
      ],
      "decision_points": [
        {"id": "DP-003", "file": "db/migration/V005__merge_conciliacion.sql", "line": 12, "kind": "merge_with_output", "condition_text": "MERGE ... WHEN MATCHED OR NOT MATCHED BY TARGET con OUTPUT $action", "branches": [{"label": "ok_match: UPDATE", "target_line": 16}, {"label": "ok_not_match: INSERT", "target_line": 18}, {"label": "source_disappeared: queda sin WHEN NOT MATCHED BY SOURCE (E2 limite)", "target_line": 21}]},
        {"id": "DP-004", "file": "db/migration/V005__merge_conciliacion.sql", "line": 32, "kind": "partial_merge_no_source", "condition_text": "usp_reconcile_partial sin WHEN NOT MATCHED BY SOURCE", "branches": [{"label": "ok -> INSERT de nuevos SKUs", "target_line": 35}, {"label": "huerfano: SKUs borrados quedan en target sin cleanup", "target_line": 35}]}
      ],
      "outcomes": [
        {"id": "R-01", "category": "success_full", "conditions": "usp_reconcile_run con source rows", "user_sees": "reconcile_lines pobladas + reconcile_audit con $action", "side_effects": ["INSERT/UPDATE en reconcile_lines", "INSERT en reconcile_audit via OUTPUT"], "reversible": true, "final_state": "conciliacion ejecutada"},
