    {"id": "TRAP-E01", "kind": "implicit_interfaces", "where": "internal/domain/repo.go (interfaces) + internal/repo/sqlite/sqlite.go (structs)", "resolution": "Go usa structural typing. SQLiteEventRepository implementa domain.EventRepository sin keyword 'implements'. La skill debe buscar la interface en domain y verificar matching de signatures con los metodos del struct."},
    {"id": "TRAP-E02", "kind": "init_function_and_blank_imports", "where": "internal/repo/sqlite/driver.go: func init() + internal/repo/sqlite/init.go: _ 'github.com/mattn/go-sqlite3' + cmd/server/main.go: blank import", "resolution": "El init() del driver sqlite3 se ejecuta al importar el package. La skill debe notar la linea de blank import que no usa el paquete pero lo carga como side effect."},
    {"id": "TRAP-E03", "kind": "go_generate_code", "where": "sqlc.yaml + wire.go + internal/repo/sqlc/db.go (stub con comentario 'NO EDITAR A MANO')", "resolution": "El codigo en internal/repo/sqlc/ se genera con `sqlc generate`. wire.go genera wire_gen.go. La skill no debe buscar el codigo de DI o queries en el repo; debe regenerar con las tools."},
    {"id": "TRAP-E04", "kind": "worker_pool_goroutines", "where": "internal/worker/pool.go: go p.worker() + chan int + select { case <-p.ctx.Done(): return; case jobID, ok := <-p.jobs: }", "resolution": "Worker pool con goroutines que reciben jobs via unbuffered channel. El select respeta ctx.Done() para shutdown. La skill debe encontrar el pool, los go statements, los channels y el select con timeout."},
    {"id": "TRAP-E05", "kind": "build_tags", "where": "internal/http/legacy_export.go: //go:build legacy", "resolution": "El codigo con build tag 'legacy' solo se compila con `-tags legacy`. No se incluye en el binario por defecto. La skill debe notar el comentario de build tag para entender cual codigo esta activo."},
    {"id": "TRAP-E06", "kind": "go_embed", "where": "internal/service/export_service.go: //go:embed templates/*.tmpl + embed.FS + templates/export.tmpl", "resolution": "El FS de templates se embebe via //go:embed al compilar. El binario es autocontenido y la ruta de la plantilla no aparece en el filesystem en runtime. La skill debe notar la directiva //go:embed y la lectura via embed.FS."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "race_condition_in_worker_pool", "where": "internal/worker/pool.go: p.processed++ (sin mutex)", "resolution": "El counter shared 'processed' se incrementa sin proteccion. En concurrencia, los updates se pierden. La trampa: el counter parece atomico pero solo se lee con atomic.LoadInt64 (la escritura NO es atomica)."},
    {"id": "TRAP-P02", "kind": "goroutine_leak_on_shutdown", "where": "cmd/server/main.go: ListenAndServe + Shutdown", "resolution": "El servidor bloquea hasta SIGTERM y luego intenta Shutdown. Los workers respetan ctx.Done() en el select. La trampa: el server HTTP no implementa graceful shutdown completo (compara err.Error() con string en vez de usar http.ErrServerClosed)."},
    {"id": "TRAP-P03", "kind": "implicit_interface_mismatch", "where": "internal/service/aggregate_service.go: ListByType(ctx, 'default', 1000, 0)", "resolution": "El exporter de SQLite usa type='default' para ListByType pero el servicio busca por type del payload. Esto es un mismatch semantico (no de tipos) porque la firma matchea pero la semantica no."},
    {"id": "TRAP-P04", "kind": "init_side_effects_in_tests", "where": "internal/repo/sqlite/driver.go: fmt.Println en init()", "resolution": "init() imprime un mensaje a stdout al importar el package. Esto es un side effect que afecta a tests silenciosos. La trampa: los tests que importan el package muestran este mensaje en su salida."},
    {"id": "TRAP-P05", "kind": "channel_deadlock", "where": "internal/worker/pool.go: make(chan int) (sin buffer)", "resolution": "El canal 'jobs' es unbuffered. Si un producer envia sin un receiver listo (workers no iniciados), hay deadlock. La trampa: el codigo parece correcto pero falla en runtime si los workers no estan corriendo."},
    {"id": "TRAP-P06", "kind": "build_tag_typo", "where": "internal/http/legacy_export.go: //go:build legacy (correcto)", "resolution": "El build tag es correcto en este fixture. La trampa P06 se demuestra con el comentario en el codigo: 'Si el tag tuviera typo (lagacy), el codigo no se compilaria con el tag esperado'."}
  ],
