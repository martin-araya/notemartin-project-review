  "traps": [
    {"id": "TRAP-E01", "kind": "signals_in_apps_ready", "where": "apps/enrollments/apps.py:10 + apps/enrollments/signals.py:17", "resolution": "EnrollmentsConfig.ready() ejecuta 'from . import signals' que conecta @receiver(post_save, sender=Enrollment). La skill no encuentra el handler mirando solo models.py; debe saltar a apps.py:ready() y a signals.py."},
    {"id": "TRAP-E02", "kind": "drf_router_generated_routes", "where": "apps/enrollments/urls.py:15-18 + apps/payments/urls.py + apps/certificates/urls.py", "resolution": "Las rutas /api/enrollments/<id>/ se generan por DefaultRouter de DRF a partir del basename. La skill no encuentra path() literales para los IDs; debe leer el router y entender el basename y el queryset."},
    {"id": "TRAP-E03", "kind": "custom_manager_queryset", "where": "apps/enrollments/managers.py + apps/enrollments/models.py:33", "resolution": "EnrollmentQuerySet expone .active(), .paid(), .by_user(); EnrollmentManager.from_queryset() los expone via Enrollment.objects. La skill no encuentra estos metodos en el Manager estandar."},
    {"id": "TRAP-E04", "kind": "settings_split_by_env", "where": "fxdjango/settings/{base,dev,prod}.py", "resolution": "DJANGO_SETTINGS_MODULE=fxdjango.settings.{dev,prod} elige archivo. dev usa SQLite :memory: + EAGER + AllowAny. prod usa SQLite file-based + EAGER=False + IsAuthenticated. La skill debe leer fxdjango/settings/dev.py para entender como correr los tests."},
    {"id": "TRAP-E05", "kind": "admin_action_no_public_route", "where": "apps/audit/admin.py:21-50 + apps/audit/urls_admin.py (no incluido en urls principal)", "resolution": "Las acciones export_csv y mark_reviewed estan registradas en AuditLogAdmin pero NO expuestas como URL publica (solo desde Django admin shell). La skill debe notar que son features accesibles via admin, no via API REST."},
    {"id": "TRAP-E06", "kind": "template_tags_and_context_processors", "where": "apps/*/templatetags/*_tags.py + apps/*/context_processors.py + fxdjango/settings/base.py:42-48", "resolution": "enrollment_status_label, payment_status_badge, certificate_is_valid son template tags; enrollment_counts, certificate_metadata son context processors. Registrados en TEMPLATES['OPTIONS']['context_processors'] de base.py. La skill debe leer fxdjango/settings/base.py para encontrarlos."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "signals_sin_transaction_envelope", "where": "apps/enrollments/signals.py:17-26", "resolution": "El receiver post_save ejecuta procesar_inscripcion.delay() sin transaction.on_commit. Si la transaccion principal falla despues, la task queda ejecutada con datos parciales. La trampa: el codigo parece correcto pero no es atómico respecto a la transaccion."},
    {"id": "TRAP-P02", "kind": "queryset_metodo_sin_indice", "where": "apps/payments/managers.py + apps/payments/models.py", "resolution": "PaymentQuerySet expone .completed(), .pending(), .for_enrollment() pero el modelo solo declara Index en status. Queries por enrollment hacen full scan en tablas grandes. La trampa: el manager expone una API comoda que enmascara la falta de indice."},
    {"id": "TRAP-P03", "kind": "admin_action_sin_permission_check", "where": "apps/audit/admin.py:24-43", "resolution": "export_csv NO verifica request.user.has_perm('audit.export_auditlog'). Cualquier staff user (sin is_superuser) puede exportar el log. La trampa es que la verificacion de permisos adicional debe hacerse explicita dentro del action."},
    {"id": "TRAP-P04", "kind": "celery_eager_swallows_exceptions", "where": "fxdjango/settings/dev.py:21 + fxdjango/celery.py", "resolution": "CELERY_TASK_ALWAYS_EAGER=True en dev/tests ejecuta las tasks sincronamente dentro del request. Excepciones se propagan al caller; en prod con un worker real, los errores van al broker y la respuesta HTTP no los ve."},
    {"id": "TRAP-P05", "kind": "router_basename_payment", "where": "apps/payments/urls.py:6", "resolution": "router.register('', PaymentViewSet, basename='payment') genera rutas con prefijo 'payment'. Cualquier codigo que use reverse('payment-list') depende de ese basename. Si cambia a 'payments' o se omite, reverse() lanza NoReverseMatch en runtime."},
    {"id": "TRAP-P06", "kind": "settings_prod_no_secret_key_env", "where": "fxdjango/settings/base.py:5 + fxdjango/settings/prod.py", "resolution": "SECRET_KEY = os.environ.get('FXDJ_SECRET_KEY', 'fxdjango-insecure-...'). En prod sin la env var, se usa el valor inseguro. Ademas, prod.py no sobreescribe DEBUG=False explicitamente en ALLOWED_HOSTS si no hay env var. La trampa: deployar sin configurar el env expone secrets debil."}
  ],
  "superficial_traps": [
    {"id": "TRAP-S01", "kind": "dead_viewset", "where": "apps/certificates/views.py:12-15", "resolution": "LegacyCertificateViewSet(viewsets.ReadOnlyModelViewSet) existe y compila pero ningun router la importa. La skill debe detectar el dead code via grep."},
    {"id": "TRAP-S02", "kind": "dead_signal_handler", "where": "apps/payments/signals.py:21-25", "resolution": "handler_pago_fallido existe como funcion pero NO esta conectado como signal (@receiver ausente). Cualquier reviewer podria asumir que el handler se ejecuta."},
    {"id": "TRAP-S03", "kind": "dead_template_tag", "where": "apps/certificates/templatetags/certificate_tags.py:11-13", "resolution": "format_certificate_id existe pero NO se usa en ninguna template del fixture. La trampa: parece util pero la skill debe detectarlo."}
  ],
