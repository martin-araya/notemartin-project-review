  "traps": [
    {"id": "TRAP-E01", "kind": "mediator_dispatch_by_type", "where": "src/Features/Pedidos/Commands/CrearPedidoHandler.cs:8 + src/Features/Pedidos/Queries/ObtenerPedidoHandler.cs:8 + Program.cs:16", "resolution": "Los handlers implementan IRequestHandler<TRequest, TResponse>. AddMediatR usa RegisterServicesFromAssembly para descubrir todos los handlers por tipo generico. La skill no encuentra un mapeo literal request->handler en los endpoints; tiene que saltar al archivo del handler y reconocer el contrato del tipo."},
    {"id": "TRAP-E02", "kind": "efcore_fluent_no_dataannotations", "where": "src/Infrastructure/Persistence/AppDbContext.cs:23 + src/Infrastructure/Persistence/Configurations/{Pedido,PedidoItem,Factura,Trabajo}Configuration.cs", "resolution": "Todo el modelo se configura en Fluent API (HasKey, Property.HasMaxLength, ToTable, HasIndex, HasConversion) dentro de IEntityTypeConfiguration<T>. No hay data annotations ([Key], [MaxLength], [Table]) en las entidades. La skill no debe buscar anotaciones; debe saltar a OnModelCreating y a las Configurations."},
    {"id": "TRAP-E03", "kind": "source_generators_not_in_repo", "where": "FxAspNet.csproj", "resolution": "MediatR 11 usa code generation interno (no visible en el repo). Ademas, EF Core genera el modelo y las migraciones en runtime. Los archivos generados viven en obj/ y se excluyen via .gitignore. La skill debe notar que 'no hay archivos' no significa 'no hay codigo'."},
    {"id": "TRAP-E04", "kind": "partial_class_split", "where": "src/Domain/Pedidos/PedidoItem.cs + src/Domain/Pedidos/PedidoItem.ParteB.cs + src/Features/Pedidos/Commands/CrearPedidoHandler.cs + CrearPedidoHandler.ParteB.cs + src/Features/Pedidos/Queries/ObtenerPedidoHandler.cs + ObtenerPedidoHandler.ParteB.cs + src/Features/Reintentos/EncolarTrabajoHandler.cs + EncolarTrabajoHandler.ParteB.cs", "resolution": "PedidoItem, CrearPedidoHandler, ObtenerPedidoHandler y EncolarTrabajoHandler son partial class repartidas en dos archivos cada una. La skill tiene que juntar ambos archivos para reconstruir la clase completa. Las 'ParteB' contienen miembros adicionales (ReferenciaCircular, Diagnostico, Etiqueta)."},
    {"id": "TRAP-E05", "kind": "middleware_pipeline_order", "where": "Program.cs:22-26", "resolution": "app.MapOrdersEndpoints() / MapBillingEndpoints() / MapRetriesEndpoints() se ejecutan ANTES de app.UseExceptionHandler(). Resultado: las excepciones lanzadas por los handlers (CrearPedidoHandler) NO se traducen a 500 limpio via ExceptionHandler; ademas, UseRequestId() declarada en src/Web/Middleware/RequestIdMiddlewareExtensions.cs:7 NUNCA se invoca. La skill debe notar que el orden del pipeline afecta que middleware envuelve los endpoints."},
    {"id": "TRAP-E06", "kind": "extension_method_registration", "where": "src/Infrastructure/Mediator/MediatorRegistration.cs:9", "resolution": "AddOrdersModule(this IServiceCollection) esta declarado y registra los handlers, pero NO se invoca desde Program.cs. Los handlers se descubren via AddMediatR(cfg => cfg.RegisterServicesFromAssembly(...)). La extension es codigo huerfano que compila pero no tiene efecto en runtime."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "handler_throws_no_handler_mapeado", "where": "src/Features/Pedidos/Commands/CrearPedidoHandler.cs:19-22 + src/Web/Endpoints/OrdersEndpoints.cs:23-30", "resolution": "El endpoint atrapa InvalidOperationException con mensajes especificos ('cliente_requerido', 'items_requeridos') y los mapea a 400. Pero otros InvalidOperationException (p. ej. 'pedido_inexistente' en EmitirFacturaHandler, 'factura_anulada' en MarcarPagadaHandler) NO se mapean a 4xx en el endpoint y burbujean a UseExceptionHandler, que esta registrado tarde (E05). La trampa: cualquier nuevo mensaje de error necesitara un catch explicito en el endpoint o sera 500."},
    {"id": "TRAP-P02", "kind": "mediator_silent_no_handler", "where": "src/Features/Pedidos/Commands/ComandoSinHandler.cs", "resolution": "ComandoSinHandler implementa IRequest<string> pero NO tiene handler registrado. MediatR no avisa en build; en runtime lanza InvalidOperationException 'No handler for command'. La skill debe detectar que el comando existe pero no tiene handler emparejado."},
    {"id": "TRAP-P03", "kind": "efcore_no_transaction_envelope", "where": "src/Features/Pedidos/Commands/CrearPedidoHandler.cs:46-52", "resolution": "El handler hace dos _db.SaveChangesAsync() consecutivos (uno para Pedido, otro para PedidoItem) sin envolver en BeginTransaction. Si el segundo save falla, el Pedido queda persistido sin sus items. La trampa: el codigo parece correcto pero no es atomico."},
    {"id": "TRAP-P04", "kind": "background_no_update_ultimo_intento", "where": "src/Infrastructure/Background/ReintentosBackgroundService.cs:52-60", "resolution": "Cuando un trabajo falla, el background service lo marca Estado=Fallido y loguea, pero NO actualiza UltimoIntentoEn (la excepcion queda en IntentarTrabajo que solo verifica Tipo/Payload no vacios). Un trabajo que siempre falla seguira apareciendo en /api/retries/pending sin cambio, dando la falsa impresion de que no se ha reintentado."},
    {"id": "TRAP-P05", "kind": "endpoint_group_route_prefix", "where": "src/Web/Endpoints/OrdersEndpoints.cs:39 vs 33", "resolution": "MapGet('/') y MapGet('/{id:int}') conviven en el mismo grupo. El orden importa: ASP.NET Core valida la ruta mas especifica ({id:int}) antes que la raiz, pero un bug sutil seria invertir el orden. La skill debe verificar que las rutas se registran en orden determinista."},
    {"id": "TRAP-P06", "kind": "sqlite_inmemory_shared_cache_required", "where": "tests/FxAspNet.Tests/Fixtures/FxAspNetFactory.cs:14", "resolution": "SQLite en memoria sin cache=shared asigna una DB distinta por conexion; WebApplicationFactory abre varias conexiones en su ciclo de vida y los tests verian datos parciales. La conexion usa 'DataSource=file:test-{guid}?mode=memory&cache=shared' que mantiene una sola DB compartida entre todas las conexiones."}
  ],
  "superficial_traps": [
    {"id": "TRAP-S01", "kind": "dead_validator", "where": "src/Features/Pedidos/Commands/CrearPedidoValidator.cs", "resolution": "CrearPedidoValidator.Validar() existe y devuelve errores, pero nadie lo invoca. La validacion real ocurre en CrearPedidoHandler (trampa P03). La skill debe notar que 'hay un archivo de validacion' no significa 'se ejecuta'."},
    {"id": "TRAP-S02", "kind": "dead_logger_field", "where": "src/Infrastructure/Persistence/AppDbContext.cs:8", "resolution": "AppDbContext declara private static readonly ILogger _log y lo inicializa con LoggerFactory.Create(b=>AddConsole()).CreateLogger. Nadie lo usa en la clase. La trampa: ILogger en EF Core DbContext es accesible via DbContextOptions, no necesita un campo estatico."},
    {"id": "TRAP-S03", "kind": "dead_endpoint", "where": "src/Web/Endpoints/OrdersEndpoints.cs:45", "resolution": "MapGet('/health') retorna 200 OK literal con {status: 'ok'}. Ningun test lo invoca. La trampa: parece util (health check) pero es dead code."}
  ],
