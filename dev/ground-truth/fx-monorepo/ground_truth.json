    {"id": "TRAP-E04", "kind": "effect_signal_http", "where": "apps/web/src/app/features/login/login.page.ts:30", "resolution": "El effect() depende de this.token; cuando cambia, dispara un GET a /api/login/me. El scanner debe razonar sobre la dependencia signal -> HTTP."},
    {"id": "TRAP-E05", "kind": "file_replacements_environments", "where": "apps/web/angular.json (build.configurations.{development,production}.fileReplacements)", "resolution": "Las configs development/production reemplazan src/environments/environment.ts por sus variantes. La trampa: el codigo fuente es uno solo, pero el binario cambia segun la build configuration."},
    {"id": "TRAP-E06", "kind": "proxy_frontend_backend", "where": "apps/web/proxy.conf.json", "resolution": "El proxy es el unico lugar donde /api (frontend) se redirige a http://localhost:3000 (backend). El codigo de las paginas solo conoce /api/*."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "feature": "FEAT-001", "kind": "missing_validation_input", "where": "apps/web/src/app/core/auth.interceptor.ts (readToken + Authorization header)", "resolution": "El interceptor agrega Authorization: Bearer ${token} sin verificar que el token no este vacio. Combinacion: el caller envia token='' y el backend recibe un header basura."},
    {"id": "TRAP-P02", "feature": "FEAT-001", "kind": "missing_cleanup", "where": "apps/web/src/app/features/login/login.service.ts (pendingLogin observable)", "resolution": "El LoginService no implementa cleanup (sin Subject, sin takeUntilDestroyed, sin unsubscribe). El observable sigue emitiendo aunque el componente se destruya. Memory leak en apps de larga vida."},
    {"id": "TRAP-P03", "feature": "FEAT-002", "kind": "over_fired_effect", "where": "apps/web/src/app/features/listings/listings.page.ts:23 (attachEffect)", "resolution": "El effect lee this completo, no solo this.filters. Cambia loading, error, lastResult o filters y el effect se vuelve a ejecutar. Renders innecesarios."},
    {"id": "TRAP-P04", "feature": "FEAT-003", "kind": "missing_size_limit", "where": "apps/api/src/routes/export.ts:37 (pageSize check)", "resolution": "Aunque hay un limit de 1000 rows (MAX_ROWS), el filtro de entrada no se valida ANTES de serializar. Un pageSize=2000 devuelve 413, pero un pageSize=999 con 999 coincidencias genera un CSV de 100MB."},
    {"id": "TRAP-P05", "feature": "FEAT-001", "kind": "null_returns_true", "where": "libs/shared/src/utils/validate.ts (isEmail)", "resolution": "isEmail(null) y isEmail(undefined) retornan true (combinacion de tipos string | null | undefined con la falta de check explicito). El formulario acepta emails nulos."},
    {"id": "TRAP-P06", "feature": "FEAT-002", "kind": "in_memory_filtering_n_plus_one", "where": "apps/api/src/routes/listings.ts:30 (applyFilters)", "resolution": "Los filtros se aplican en memoria despues de cargar TODOS los listings. Con 10k items, el filter+sort es O(n) por cada request. En produccion deberia delegar a SQL."}
  ]
}
