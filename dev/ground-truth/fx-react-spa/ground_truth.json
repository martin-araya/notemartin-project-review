  "traps": [
    {"id": "TRAP-E01", "kind": "router_loader_action", "where": "src/routes/router.tsx:48 + src/features/catalog/productsLoader.ts:12 + src/features/checkout/checkoutAction.ts:15", "resolution": "El fetch de productos y el submit de checkout viven en archivos separados invocados desde el router. La skill debe buscar loaders/actions en el router, no en el componente."},
    {"id": "TRAP-E02", "kind": "rtk_query_autogenerated_hooks", "where": "src/api/baseApi.ts:24-58 (endpoints) + features/{catalog,orders}/src/hooks.ts (imports)", "resolution": "Los hooks useGetProductsQuery/useGetOrdersQuery NO estan definidos como `function useGetProductsQuery(...)` en ninguna linea. Se generan en build por createApi. La skill debe leer los endpoints y deducir los hooks."},
    {"id": "TRAP-E03", "kind": "nested_providers", "where": "src/main.tsx:30-50", "resolution": "6 providers anidados en orden StoreProvider QueryClient I18nextProvider ThemeProvider ToastProvider ErrorBoundary. Cambiar el orden cambia la propagacion de errores, las traducciones y los toasts."},
    {"id": "TRAP-E04", "kind": "useEffect_chain", "where": "src/features/catalog/catalog.hooks.ts:14-29", "resolution": "Tres useEffect consecutivos que comparten state via useDebounce. Cambiar query dispara tres efectos encadenados (debounced, category, ambos)."},
    {"id": "TRAP-E05", "kind": "import_meta_env_vite", "where": "src/lib/env.ts:3-8", "resolution": "Las variables VITE_API_URL y VITE_DEFAULT_LOCALE se reemplazan en build por Vite. En tests se mockean con vi.stubEnv. La skill debe notar que no son variables de proceso."},
    {"id": "TRAP-E06", "kind": "memo_forwardref_hoc_suspense_errorboundary", "where": "src/components/Button.tsx (forwardRef+memo) + src/features/cart/CartItem.tsx (forwardRef+memo+withLogger) + src/routes/router.tsx (errorElement) + src/main.tsx (Suspense)", "resolution": "Multiples capas de wrapping; el orden memo/forwardRef/HOC cambia el displayName. La skill debe mapear cada export default/no-default y reconstruir el wrapping."}
  ],
  "package_traps": [
