    {
      "id": "FEAT-004",
      "name": "notificaciones-asíncronas",
      "user_description": "Las notificaciones se envian automaticamente via @TransactionalEventListener(AFTER_COMMIT) cuando se confirma una transferencia. Como la app no tiene @EnableAsync, el envio es sincrono aunque @Async este declarado.",
      "traces": [
        {"n": 1, "what": "TransferenciaService.confirmar llama publisher.publishEvent", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:65", "data_in": "TransferenciaRealizadaEvent", "data_out": "event published"},
        {"n": 2, "what": "Spring busca listeners con @TransactionalEventListener", "cite": "src/main/java/com/example/fxspring/listener/NotificacionListener.java:35", "data_in": "event", "data_out": "listener triggered"},
        {"n": 3, "what": "AFTER_COMMIT: el listener corre despues del commit de la transaccion padre", "cite": "src/main/java/com/example/fxspring/listener/NotificacionListener.java:35", "data_in": "-", "data_out": "listener execution"},
        {"n": 4, "what": "listener llama notificaciones.enviar() (sincrono, no async)", "cite": "src/main/java/com/example/fxspring/listener/NotificacionListener.java:40", "data_in": "destinatario, mensaje", "data_out": "Notificacion saved"},
        {"n": 5, "what": "listener llama auditoria.registrar() (sync)", "cite": "src/main/java/com/example/fxspring/listener/NotificacionListener.java:43", "data_in": "accion, entidad, etc", "data_out": "Auditoria saved"}
      ],
      "decision_points": [
        {"id": "DP-005", "file": "src/main/java/com/example/fxspring/listener/NotificacionListener.java", "line": 35, "kind": "transaction_phase", "condition_text": "@TransactionalEventListener(phase = AFTER_COMMIT)", "branches": [{"label": "commit -> listener OK", "target_line": 36}, {"label": "rollback -> listener NO corre", "target_line": 35}]}
      ],
      "outcomes": [
        {"id": "R-01", "category": "success_dispatch", "conditions": "Transferencia confirmada y commit exitoso", "user_sees": "Notificacion creada en la DB con estado=ENVIADO", "side_effects": ["INSERT en notificaciones"], "reversible": false, "final_state": "listener executed"},
        {"id": "R-02", "category": "success_after_commit", "conditions": "Transferencia hace commit normal", "user_sees": "Listener se ejecuta despues del commit (no durante)", "side_effects": [], "reversible": true, "final_state": "rendered"},
        {"id": "R-03", "category": "error_silent_failure", "conditions": "Listener lanza RuntimeException", "user_sees": "Spring la ignora silenciosamente; el log de Spring muestra un warning", "side_effects": [], "reversible": false, "final_state": "noop"},
