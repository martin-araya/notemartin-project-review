    {
      "id": "FEAT-001",
      "name": "cuentas",
      "user_description": "El usuario crea una cuenta con email y titular, valida el email con @Email, persiste con H2/Postgres, y lista paginado por estado.",
      "traces": [
        {"n": 1, "what": "User POST /api/v1/cuentas con JSON {email, titular}", "cite": "src/main/java/com/example/fxspring/controller/CuentaController.java:29", "data_in": "JSON body", "data_out": "POST request"},
        {"n": 2, "what": "@Valid activa jakarta.validation: @Email rechaza formato invalido", "cite": "src/main/java/com/example/fxspring/domain/Cuenta.java:25", "data_in": "Cuenta", "data_out": "BindingResult"},
        {"n": 3, "what": "CuentaController.crear delega a service.crear()", "cite": "src/main/java/com/example/fxspring/controller/CuentaController.java:29", "data_in": "Cuenta", "data_out": "Cuenta"},
        {"n": 4, "what": "service.crear busca duplicados via repo.findByEmail", "cite": "src/main/java/com/example/fxspring/service/CuentaService.java:31", "data_in": "email", "data_out": "Optional<Cuenta>"},
        {"n": 5, "what": "Si email duplicado -> 400 IllegalStateException", "cite": "src/main/java/com/example/fxspring/service/CuentaService.java:32", "data_in": "Optional", "data_out": "error"},
        {"n": 6, "what": "Lombok @Data genera setters que inicializan saldo=0", "cite": "src/main/java/com/example/fxspring/service/CuentaService.java:34", "data_in": "Cuenta", "data_out": "Cuenta"},
        {"n": 7, "what": "repo.save persiste y devuelve 201 con la cuenta", "cite": "src/main/java/com/example/fxspring/service/CuentaService.java:35", "data_in": "Cuenta", "data_out": "Cuenta saved"}
      ],
      "decision_points": [
        {"id": "DP-001", "file": "src/main/java/com/example/fxspring/service/CuentaService.java", "line": 31, "kind": "validation", "condition_text": "repo.findByEmail(c.getEmail()).isPresent()", "branches": [{"label": "ok -> save", "target_line": 35}, {"label": "duplicado -> 400", "target_line": 32}]}
      ],
      "outcomes": [
        {"id": "R-01", "category": "success_create", "conditions": "POST con email valido y titular", "user_sees": "201 con la cuenta creada (id asignado)", "side_effects": ["INSERT en cuentas"], "reversible": false, "final_state": "cuenta creada"},
        {"id": "R-02", "category": "success_get_by_id", "conditions": "GET /api/v1/cuentas/{id} con id existente", "user_sees": "200 con la cuenta", "side_effects": [], "reversible": true, "final_state": "rendered"},
        {"id": "R-03", "category": "error_get_404", "conditions": "GET con id inexistente", "user_sees": "404 Not Found", "side_effects": [], "reversible": true, "final_state": "rejected"},
        {"id": "R-04", "category": "error_validation_zod", "conditions": "POST con email formato invalido", "user_sees": "400 Bad Request", "side_effects": [], "reversible": true, "final_state": "rejected"},
        {"id": "R-05", "category": "success_list_paginated", "conditions": "GET /api/v1/cuentas?page=0&size=10", "user_sees": "200 con Page<Cuenta>", "side_effects": [], "reversible": true, "final_state": "rendered"},
        {"id": "R-06", "category": "error_create_duplicate", "conditions": "POST con email que ya existe", "user_sees": "500 IllegalStateException (mapeado por Spring)", "side_effects": [], "reversible": true, "final_state": "rejected"},
        {"id": "R-07", "category": "error_unauthorized_401", "conditions": "POST sin Authorization header", "user_sees": "401 (SecurityFilterChain lo bloquea)", "side_effects": [], "reversible": true, "final_state": "unauthorized"}
      ],
