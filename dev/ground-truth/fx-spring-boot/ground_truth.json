        {"id": "R-05", "category": "success_duplicate_dispatch", "conditions": "publisher.publishEvent se llama 2 veces para el mismo evento", "user_sees": "2 notificaciones creadas", "side_effects": ["2x INSERT"], "reversible": false, "final_state": "duplicate"},
        {"id": "R-06", "category": "error_pre_commit", "conditions": "Si el listener usara BEFORE_COMMIT y fallara", "user_sees": "La transaccion padre haria rollback (en este caso es AFTER_COMMIT, asi que no aplica)", "side_effects": [], "reversible": true, "final_state": "noop"},
        {"id": "R-07", "category": "error_db_unavailable", "conditions": "DB caida al ejecutar el listener en AFTER_COMMIT", "user_sees": "Excepcion al insertar; Spring la ignora silenciosamente", "side_effects": [], "reversible": false, "final_state": "noop"}
