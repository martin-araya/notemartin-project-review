    {
      "id": "FEAT-002",
      "name": "transferencias",
      "user_description": "El usuario crea una transferencia entre dos cuentas, la confirma (cambia estado y dispara evento) y puede listar por origen. La confirmacion dispara el listener transaccional que crea la notificacion y el registro de auditoria.",
      "traces": [
        {"n": 1, "what": "User POST /api/v1/transferencias con {cuentaOrigenId, cuentaDestinoId, monto}", "cite": "src/main/java/com/example/fxspring/controller/TransferenciaController.java:32", "data_in": "JSON body", "data_out": "POST"},
        {"n": 2, "what": "TransferenciaController.crear delega a service.crear()", "cite": "src/main/java/com/example/fxspring/controller/TransferenciaController.java:32", "data_in": "body", "data_out": "Transferencia"},
        {"n": 3, "what": "service.crear llama this.validarSaldo() (auto-invocation bug)", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:38", "data_in": "monto", "data_out": "validarSaldo()"},
        {"n": 4, "what": "Trampa: validarSaldo corre en la misma transaccion, no en REQUIRES_NEW", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:56", "data_in": "monto", "data_out": "throw RuntimeException"},
        {"n": 5, "what": "Si monto >= 0, persiste Transferencia con estado PENDIENTE", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:40", "data_in": "Transferencia", "data_out": "Transferencia saved"},
        {"n": 6, "what": "User PATCH /api/v1/transferencias/{id}/confirmar", "cite": "src/main/java/com/example/fxspring/controller/TransferenciaController.java:40", "data_in": "id", "data_out": "PATCH"},
        {"n": 7, "what": "service.confirmar hace findByIdForUpdate (PESSIMISTIC_WRITE) + setEstado COMPLETADA + save", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:62", "data_in": "id", "data_out": "Transferencia"},
        {"n": 8, "what": "publisher.publishEvent(TransferenciaRealizadaEvent) -> @TransactionalEventListener AFTER_COMMIT", "cite": "src/main/java/com/example/fxspring/service/TransferenciaService.java:65", "data_in": "id", "data_out": "event published"}
      ],
      "decision_points": [
        {"id": "DP-002", "file": "src/main/java/com/example/fxspring/service/TransferenciaService.java", "line": 38, "kind": "auto_invocation", "condition_text": "this.validarSaldo() (intercepcion AOP rota)", "branches": [{"label": "monto >= 0 -> save", "target_line": 40}, {"label": "monto < 0 -> throw", "target_line": 56}]},
        {"id": "DP-003", "file": "src/main/java/com/example/fxspring/service/TransferenciaService.java", "line": 62, "kind": "lookup", "condition_text": "repo.findByIdForUpdate(id).isPresent()", "branches": [{"label": "ok -> save + publish event", "target_line": 65}, {"label": "not_found", "target_line": 63}]}
      ],
      "outcomes": [
        {"id": "R-01", "category": "success_create", "conditions": "POST con cuentaOrigenId, cuentaDestinoId, monto > 0", "user_sees": "201 con la transferencia en estado PENDIENTE", "side_effects": ["INSERT en transferencias"], "reversible": false, "final_state": "transferencia creada"},
        {"id": "R-02", "category": "success_confirm", "conditions": "PATCH con id existente", "user_sees": "200 con la transferencia en estado COMPLETADA", "side_effects": ["UPDATE transferencias", "INSERT en notificaciones (via listener)", "INSERT en auditoria (via listener)"], "reversible": false, "final_state": "transferencia completada"},
        {"id": "R-03", "category": "error_optimistic_lock", "conditions": "PATCH con version desactualizada (no se maneja)", "user_sees": "500 con OptimisticLockException stack trace", "side_effects": [], "reversible": false, "final_state": "upsert silencioso"},
        {"id": "R-04", "category": "error_saldo_insuficiente", "conditions": "POST con monto < 0", "user_sees": "500 con RuntimeException", "side_effects": [], "reversible": true, "final_state": "rejected"},
        {"id": "R-05", "category": "error_auto_invocation_no_rollback", "conditions": "this.validarSaldo() desde crear()", "user_sees": "La transaccion padre se hace rollback aunque validarSaldo use REQUIRES_NEW (porque no se intercepta)", "side_effects": [], "reversible": false, "final_state": "rollback no esperado"},
        {"id": "R-06", "category": "success_event_listener", "conditions": "Transferencia confirmada con publisher.publishEvent", "user_sees": "Notificacion creada, registro de auditoria creado (AFTER_COMMIT)", "side_effects": ["INSERT en notificaciones", "INSERT en auditoria"], "reversible": false, "final_state": "listener executed"},
        {"id": "R-07", "category": "error_unauthorized_403", "conditions": "DELETE /api/v1/transferencias/{id} con @PreAuthorize incorrecto", "user_sees": "200 (la SpEL pasa porque id == authentication.principal.id solo para userId)", "side_effects": [], "reversible": true, "final_state": "noop"}
      ],
      "config": [
        {"key": "lock.pessimistic", "kind": "literal", "default": "LockModeType.PESSIMISTIC_WRITE", "effect": "bloquea la fila durante la confirmacion"},
        {"key": "auto.invocation", "kind": "literal", "default": "this.validarSaldo()", "effect": "by-passes AOP proxy (trampa)"}
      ]
    },
