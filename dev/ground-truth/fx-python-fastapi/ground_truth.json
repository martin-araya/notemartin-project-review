  "traps": [
    {"id": "TRAP-E01", "kind": "depends_yield_chains", "where": "app/dependencies.py:20-44", "resolution": "Cadena: get_db (yield) -> get_current_user (Depends(get_db)) -> get_active_subscription (Depends(get_current_user) + Depends(get_db)). La skill debe leer este archivo para entender la cadena completa; no saltar directamente a los endpoints."},
    {"id": "TRAP-E02", "kind": "pydantic_validator_with_business_logic", "where": "app/schemas/user.py:23-31 + app/schemas/subscription.py:23-33", "resolution": "@field_validator('email') en UserCreate normaliza el email (lower). El @model_validator(mode='after') en SubscriptionCreate valida fechas. Los validadores tienen side effects (queries / normalizacion) que parecen pura validacion. La unicidad real ocurre en el servicio sin lock (P01)."},
    {"id": "TRAP-E03", "kind": "include_router_prefix_and_dependencies", "where": "app/routers/users.py + app/routers/subscriptions.py + app/routers/webhooks.py", "resolution": "users.router con prefix='/users' + dependencies=[Depends(get_current_user)]. subscriptions.router con prefix='/subscriptions' + dependencies=[Depends(get_active_subscription)]. webhooks.router con prefix='/webhooks' SIN dependencies (publico, contraste)."},
    {"id": "TRAP-E04", "kind": "lifespan_events", "where": "app/main.py:14-31", "resolution": "@asynccontextmanager async def lifespan(app) con startup (init_db + try/except que swallowea, trampa P04) y shutdown (close_db). Los side effects viven en lifespan, no en endpoints."},
    {"id": "TRAP-E05", "kind": "custom_decorator_registers_routes", "where": "app/decorators.py:23-40", "resolution": "@track_request incrementa un counter global _REQUEST_REGISTRY y registra la funcion en _REGISTERED_ROUTES. El decorador hace route registration como side effect, no solo wrap."},
    {"id": "TRAP-E06", "kind": "alembic_migration_with_data", "where": "alembic/versions/002_seed_data.py", "resolution": "La migration 002_seed_data.py hace op.execute('INSERT INTO ...') para backfill de datos, NO solo schema. La skill debe notar que la migration incluye data migration."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "pydantic_validator_race", "where": "app/schemas/user.py:23-31 + app/services/user_service.py:20", "resolution": "El @field_validator normaliza el email pero NO consulta la DB. La unicidad se valida en user_service.create_user con un SELECT sin lock (TOCTOU). En concurrencia dos requests pueden pasar la validacion y el segundo INSERT falla con UNIQUE constraint."},
    {"id": "TRAP-P02", "kind": "yield_dep_no_rollback_on_error", "where": "app/dependencies.py:20-23", "resolution": "get_db cierra la sesion pero NO hace rollback si hay excepcion. Cambios pendientes pueden quedar antes del close. El yield no envuelve un try/except con await session.rollback()."},
    {"id": "TRAP-P03", "kind": "include_router_order_shadows", "where": "app/main.py:39-41", "resolution": "El orden de include_router importa. En este fixture: users, subscriptions, webhooks en ese orden. Si un router posterior tiene prefix='' y rutas como '/users', shadowearia los users. La trampa: el orden determina precedencia."},
    {"id": "TRAP-P04", "kind": "lifespan_exception_swallowed", "where": "app/main.py:18-26", "resolution": "El startup tiene try/except Exception que swallowea init_db errors con un warning. La app arranca con DB no inicializada y los endpoints fallan con errores cripticos en runtime."},
    {"id": "TRAP-P05", "kind": "custom_decorator_breaks_signature", "where": "app/decorators.py:23-40", "resolution": "track_request NO preserva los metadatos del callable original. El wrapper no usa functools.wraps, asi que __name__ del wrapper es 'wrapper' en lugar del nombre de la funcion decorada. FastAPI ve el endpoint con un nombre generico."},
    {"id": "TRAP-P06", "kind": "celery_eager_in_async_context", "where": "app/tasks/webhook_tasks.py:15 + app/services/webhook_service.py:38-49", "resolution": "dispatch_webhook_event es 'async def' decorada con @shared_task. Celery 5.3 NO soporta coroutines nativamente. En EAGER mode la coroutine se retorna como resultado sin ejecutarse; el side effect (HTTP POST al webhook URL) se pierde silenciosamente. La trampa: celery_eager en contexto async engaña al programador."}
  ],
