  "traps": [
    {"id": "TRAP-E01", "kind": "modules_di_decorators", "where": "src/app.module.ts:34 + src/orders/orders.module.ts:18 + src/shipments/shipments.module.ts:14 + src/notifications/notifications.module.ts + nest-cli.json", "resolution": "Cada @Module({imports, providers, controllers}) define el grafo DI. La skill debe leer nest-cli.json + app.module.ts + cada .module.ts para entender la estructura completa."},
    {"id": "TRAP-E02", "kind": "app_guard_app_interceptor", "where": "src/app.module.ts:58-70 providers: [{provide: APP_GUARD, useClass: AuthGuard}, {provide: APP_INTERCEPTOR, useClass: TimingInterceptor}, {provide: APP_FILTER, useClass: HttpExceptionFilter}]", "resolution": "Los guards/interceptors/filters globales se registran via providers con tokens especiales APP_GUARD, APP_INTERCEPTOR, APP_FILTER. La skill debe notar el array providers de app.module.ts, no solo buscar @UseGuards() en controllers."},
    {"id": "TRAP-E03", "kind": "custom_decorator_reflector", "where": "src/common/decorators/roles.decorator.ts + src/common/guards/auth.guard.ts:Reflector.getAllAndOverride + src/common/interceptors/timing.interceptor.ts:Reflector.get + src/common/decorators/log-execution.decorator.ts", "resolution": "Los decoradores usan SetMetadata(key, value); los guards/interceptors leen via Reflector.get(key, target). La skill debe correlacionar la key en SetMetadata con la key en Reflector.get."},
    {"id": "TRAP-E04", "kind": "bullmq_producer_consumer_by_name", "where": "src/orders/orders.service.ts:48 publish('order-queue', ...) + src/notifications/notifications.service.ts:27 publish('order-queue', ...)", "resolution": "Productor y consumidor estan acoplados SOLO por el string 'order-queue'. La skill debe grep este string en toda la codebase."},
    {"id": "TRAP-E05", "kind": "event_pattern_message_pattern", "where": "src/messaging/microservice.controller.ts:17 @MessagePattern('order_created') + src/messaging/order-event.handler.ts:17 @EventPattern('order_created') + src/main.ts:30 app.connectMicroservice(...)", "resolution": "Los handlers con @MessagePattern/@EventPattern solo se registran si app.connectMicroservice se llama. La skill debe encontrar este bootstrap en main.ts."},
    {"id": "TRAP-E06", "kind": "config_module_namespaces", "where": "src/config/{database,redis,app}.config.ts:registerAs(...) + src/config/validation.schema.ts + src/app.module.ts:load: [databaseConfig, redisConfig, appConfig], validationSchema", "resolution": "Cada config tiene un namespace; ConfigType<typeof XxxConfig> da tipos. La skill debe leer el array load: de ConfigModule.forRoot para entender los namespaces."}
  ],
  "package_traps": [
    {"id": "TRAP-P01", "kind": "circular_module_dependency", "where": "src/orders/orders.module.ts:21 forwardRef(() => ShipmentsModule) + src/shipments/shipments.module.ts (NO importa OrdersModule)", "resolution": "El ciclo existia pero se resolvio con forwardRef en OrdersModule. NestJS ahora puede construir ambos modulos. La trampa: sin forwardRef, la app falla al boot."},
    {"id": "TRAP-P02", "kind": "global_guard_throws_on_missing_context", "where": "src/common/guards/auth.guard.ts:33 throw new InternalServerErrorException('user context missing')", "resolution": "El guard deberia lanzar una excepcion de autenticacion (401) cuando no hay request.user. En su lugar lanza InternalServerErrorException (500). El codigo HTTP es incorrecto."},
    {"id": "TRAP-P03", "kind": "bullmq_producer_no_consumer_validation", "where": "src/notifications/notifications.service.ts:27 await this.queue.publish('order-queue', ...)", "resolution": "El productor no verifica que haya un consumer suscrito a la cola. Si nadie escucha, el mensaje se pierde silenciosamente."},
    {"id": "TRAP-P04", "kind": "interceptor_breaks_streaming", "where": "src/common/interceptors/timing.interceptor.ts (resuelto con .pipe(tap(...)))", "resolution": "El codigo original tenia return next.handle() sin .pipe() para observables de stream. La version actual usa .pipe(tap(...)) para preservar el stream."},
    {"id": "TRAP-P05", "kind": "custom_decorator_metadata_key_typo", "where": "src/common/decorators/log-execution.decorator.ts:'log_execution_time' vs src/common/interceptors/timing.interceptor.ts:'LogExecutionTime'", "resolution": "Las keys no coinciden (case-sensitive). El decorator pone la key en minusculas pero el interceptor lee con mayusculas. El interceptor nunca encuentra metadata y nunca actua."},
    {"id": "TRAP-P06", "kind": "microservice_transport_not_connected", "where": "src/main.ts:30 app.connectMicroservice<MicroserviceOptions>({transport: Transport.TCP, options: {host: '0.0.0.0', port: port + 1}})", "resolution": "La llamada ESTA presente. Sin embargo, en algunas rutas de configuracion (e.g. si NODE_ENV no esta definido o la lista de transports falla), el microservice no se registra y los handlers @MessagePattern/@EventPattern quedan sin escuchar."}
